# Foundry
out/
cache/
broadcast/*/dry-run/
# Local-chain broadcast logs are noise; real deployments are recorded in deployments/
broadcast/*/31337/
docs/src/

# Env / secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem
keystore/

# Node (gas-report tooling)
node_modules/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Coverage
lcov.info
coverage/

# Generated by tests under different optimizer profiles; docs/GAS.md is canonical.
snapshots/

# Local security tools and Python caches
.venv-security/
__pycache__/
*.pyc

# Simulated deployments are never confirmed release records.
deployments/simulations/
