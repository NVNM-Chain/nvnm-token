# ---------------------------------------------------------------------------
#  NVNM — example environment. Copy to .env and fill in.
#
#  .env is gitignored. NEVER put a private key in it.
# ---------------------------------------------------------------------------

# --- RPC endpoints (required for the network you are targeting) -------------
# Referenced by [rpc_endpoints] in foundry.toml as
# --rpc-url mainnet|sepolia|hoodi|base|base_sepolia.
MAINNET_RPC_URL=https://eth-mainnet.example.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.example.com/v2/YOUR_KEY
HOODI_RPC_URL=https://ethereum-hoodi.publicnode.com
BASE_RPC_URL=https://base-mainnet.example.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.example.com/v2/YOUR_KEY

# --- Block explorer verification (required for --verify) --------------------
# One Etherscan V2 key covers mainnet, Sepolia, Hoodi, Base and Base Sepolia.
ETHERSCAN_API_KEY=

# --- Deployment parameters --------------------------------------------------
# Receives 100% of supply. TESTNETS ONLY.
# Ethereum mainnet and Base mainnet ignore this: their treasuries are reviewed
# constants in script/config/Config.sol, so the address that receives the entire
# supply is visible in version control rather than in someone's shell.
TREASURY=

# Required for any production broadcast (Ethereum mainnet or Base mainnet).
# Absent or false, script/Deploy.s.sol reverts.
# I_UNDERSTAND_THIS_IS_MAINNET=true

# --- Verification of an existing deployment ---------------------------------
# Both values are required and must come from the reviewed deployment record.
NVNM_TOKEN_ADDRESS=
EXPECTED_CHAIN_ID=

# ---------------------------------------------------------------------------
#  KEY MANAGEMENT
#
#  There is deliberately no PRIVATE_KEY entry. A key in a shell environment
#  leaks through history, process listings, CI logs and crash dumps, and the
#  treasury mint is not reversible.
#
#  Use an encrypted keystore:
#      cast wallet import deployer --interactive
#      forge script script/Deploy.s.sol --account deployer --rpc-url sepolia \
#        --broadcast --skip-simulation
#
#  Or a hardware wallet:
#      forge script script/Deploy.s.sol --ledger --sender 0xYourAddress \
#        --rpc-url mainnet --broadcast --skip-simulation --slow
#
#  --skip-simulation takes gas limits from the network's node; see the
#  Makefile's deploy targets.
# ---------------------------------------------------------------------------
